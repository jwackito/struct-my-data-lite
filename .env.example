# Copy to .env and fill with real values. .env is gitignored — never commit it.

# PostgreSQL password for the database service (openssl rand -hex 16)
# POSTGRES_PASSWORD=

# Fernet key for encrypting stored provider secrets.
# Generate with:
#   docker compose exec app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_SECRET_KEY=

# Secret for signing JWTs (openssl rand -hex 32). Unset -> random per restart,
# which logs everyone out. Set it once and keep it stable.
# JWT_SECRET=

# Ollama server base URL (defaults to host.docker.internal:11434)
# OLLAMA_HOST=http://192.168.2.4:11434

# Model names for text and image extraction
# OLLAMA_MODEL=qwen3.6:35b
# OLLAMA_VISION_MODEL=gemma4:31b

# Whether public registration is open (true/false)
# ALLOW_REGISTRATION=true
