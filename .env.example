# Copy to etc/.env and fill with real values. etc/ is gitignored — never commit it.
#   mkdir -p etc && chmod 700 etc
#   cp .env.example etc/.env && chmod 600 etc/.env

# PostgreSQL password for the database service (openssl rand -hex 16)
# POSTGRES_PASSWORD=

# Fernet key for encrypting stored provider secrets.
# Generate with:
#   docker compose exec app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_SECRET_KEY=

# Secret for signing JWTs (openssl rand -hex 32). Unset -> random per restart,
# which logs everyone out. Set it once and keep it stable.
# JWT_SECRET=

# Ollama server base URL (defaults to host.docker.internal:11434)
# OLLAMA_HOST=http://192.168.2.4:11434

# Model names for text and image extraction
# OLLAMA_MODEL=qwen3.6:35b
# OLLAMA_VISION_MODEL=gemma4:31b

# Whether public registration is open (true/false)
# ALLOW_REGISTRATION=true

# Host port Caddy publishes for HTTPS (also the container listen port).
# Default 443. Set e.g. 8080 when the router forwards a different external
# port (like 8089) to the host; the Caddyfile site address must use the same
# port (e.g. "example.com:8080").
# HTTPS_PORT=443

# Rate limiting: requests per minute per user (auth routes key on client IP).
# In-memory and per-process, so the effective limit scales with worker count.
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_EXTRACT=30
# RATE_LIMIT_BATCH=5

# Background jobs: concurrent jobs and how many may wait before enqueues are
# rejected with 503.
# BATCH_CONCURRENCY=2
# JOB_QUEUE_MAX=4
